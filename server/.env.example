# Copy this file to .env and change values as needed.
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/clubhub
# Front-end origin allowed by CORS (the Vite dev server)
CORS_ORIGIN=http://localhost:5173
# Signs login tokens. Required when NODE_ENV=production. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long a login lasts
TOKEN_DAYS=7
